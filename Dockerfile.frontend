FROM node:20-alpine AS deps
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

FROM node:20-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY frontend/ ./
ARG NEXT_PUBLIC_BACKEND_URL=https://maindevhoon-cogniroute-backend.hf.space
ENV NEXT_PUBLIC_BACKEND_URL=$NEXT_PUBLIC_BACKEND_URL
RUN npm run build

FROM node:20-alpine AS runner
RUN adduser -S -u 1000 user
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=7860
ENV HOSTNAME=0.0.0.0

COPY --from=builder --chown=user /app/public ./public
COPY --from=builder --chown=user /app/.next/standalone ./
COPY --from=builder --chown=user /app/.next/static ./.next/static

USER user
EXPOSE 7860
CMD ["node", "server.js"]
