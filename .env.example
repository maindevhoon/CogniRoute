# CogniRoute Environment Variables
# Copy to .env and fill in values

# ---- Backend (Python/FastAPI) ----

# Primary LLM endpoint (vLLM or OpenAI-compatible)
COGNIROUTE_OPENAI_BASE_URL=
COGNIROUTE_OPENAI_API_KEY=

# Optional: per-role LLM endpoints (override the primary endpoint)
COGNIROUTE_ARCHITECT_BASE_URL=
COGNIROUTE_VERIFIER_BASE_URL=
COGNIROUTE_WORKER_BASE_URL=

# LLM timeout (seconds, default: 180)
COGNIROUTE_LLM_TIMEOUT_S=180

# Model overrides (defaults shown)
COGNIROUTE_ARCHITECT_MODEL=Qwen/Qwen2.5-32B-Instruct
COGNIROUTE_WORKER_MODEL=Qwen/Qwen2.5-7B-Instruct
COGNIROUTE_VERIFIER_MODEL=Qwen/Qwen2.5-32B-Instruct

# Simulation/Showcase mode (default: true if COGNIROUTE_OPENAI_BASE_URL is blank)
# If true, runs a high-fidelity local simulation showing the multi-agent retry logic
# without making any external LLM calls (completely free to run/showcase).
COGNIROUTE_MOCK_MODE=true

